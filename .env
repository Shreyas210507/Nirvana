# Nirvana Environment Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Nirvana
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# SQLite + JWT Security Settings
JWT_SECRET=nirvana-hyperlocal-jwt-secret-key-2026-production
JWT_REFRESH_SECRET=nirvana-hyperlocal-refresh-secret-2026
JWT_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d

# Pilot City
DEFAULT_CITY=hyderabad
DEFAULT_CITY_LAT=17.385
DEFAULT_CITY_LNG=78.4867
DEMO_MODE=true
