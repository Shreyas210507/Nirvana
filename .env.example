# Nirvana Environment Configuration
# Copy this file to .env and fill in values

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Nirvana
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# =============================================================================
# DATABASE (PostgreSQL + PostGIS)
# =============================================================================
DATABASE_URL=postgresql://Nirvana:nw_dev_password@localhost:5432/Nirvana
POSTGRES_USER=Nirvana
POSTGRES_PASSWORD=nw_dev_password
POSTGRES_DB=Nirvana

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# =============================================================================
# AUTH
# =============================================================================
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_EXPIRY=300
OTP_LENGTH=6
# Mock OTP provider (always succeeds with code 123456)
OTP_PROVIDER=mock
# For production: OTP_PROVIDER=twilio or OTP_PROVIDER=msg91
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# =============================================================================
# WEATHER DATA
# =============================================================================
# Open-Meteo (free, no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Optional: OpenWeatherMap
# OWM_API_KEY=
# Optional: IMD feeds
# IMD_API_URL=

# =============================================================================
# MAP
# =============================================================================
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
NEXT_PUBLIC_MAP_CENTER_LAT=17.385
NEXT_PUBLIC_MAP_CENTER_LNG=78.4867
NEXT_PUBLIC_MAP_ZOOM=11

# =============================================================================
# SMS / WHATSAPP / VOICE (Mocked by default)
# =============================================================================
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
VOICE_PROVIDER=mock
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# =============================================================================
# PUSH NOTIFICATIONS (VAPID)
# =============================================================================
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@Nirvana.in

# =============================================================================
# TRANSLATION
# =============================================================================
TRANSLATION_PROVIDER=mock
# GOOGLE_TRANSLATE_API_KEY=
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=

# =============================================================================
# TTS (Text-to-Speech)
# =============================================================================
TTS_PROVIDER=web-speech
# GOOGLE_TTS_API_KEY=
# BHASHINI_TTS_API_KEY=

# =============================================================================
# ML MODEL
# =============================================================================
MODEL_PATH=./ml/models
RISK_RECOMPUTE_INTERVAL=900
RISK_CACHE_TTL=300

# =============================================================================
# CELERY / WORKERS
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# FILE UPLOADS
# =============================================================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
UPLOAD_PATH=./uploads

# =============================================================================
# PILOT CITY
# =============================================================================
DEFAULT_CITY=hyderabad
DEFAULT_CITY_LAT=17.385
DEFAULT_CITY_LNG=78.4867

# =============================================================================
# DEMO
# =============================================================================
DEMO_MODE=true
DEMO_SCENARIO_SPEED=1.0
